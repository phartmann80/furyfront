# Fury Front — production deploy environment (copy to deploy.env, never commit deploy.env)

# SSH target (key-based auth via ssh-agent or ~/.ssh/config — no passwords here)
FURYFRONT_SSH_HOST=furyfront.app
FURYFRONT_SSH_USER=deploy
FURYFRONT_SSH_PORT=22

# Remote layout
FURYFRONT_REMOTE_ROOT=/var/www/furyfront
FURYFRONT_RELEASES_DIR=releases
FURYFRONT_CURRENT_LINK=current
FURYFRONT_PREVIOUS_LINK=previous

# nginx
FURYFRONT_NGINX_TEST_CMD="sudo nginx -t"
FURYFRONT_NGINX_RELOAD_CMD="sudo systemctl reload nginx"

# Local build
FURYFRONT_SKIP_VALIDATE=0
FURYFRONT_SKIP_GODOT_EXPORT=0

# Retention: keep this many release directories on server (0 = keep all)
FURYFRONT_KEEP_RELEASES=5

# Optional rsync extra flags (e.g. -e "ssh -i /path/to/key")
FURYFRONT_RSYNC_SSH=""
